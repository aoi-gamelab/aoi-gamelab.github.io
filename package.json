{
  "name": "project-archive",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "node scripts/astro.mjs dev --host 127.0.0.1",
    "build": "node scripts/astro.mjs check && node scripts/astro.mjs build && node scripts/check-build.mjs",
    "preview": "node scripts/astro.mjs preview --host 127.0.0.1",
    "check": "node scripts/astro.mjs check",
    "test": "node --test tests/*.test.mjs",
    "new:project": "node scripts/new-project.mjs",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/noto-sans-jp": "5.3.1",
    "astro": "7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
