---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import {allProjects,pathTo,imagePath,dateLabel,type Project} from '../../lib/site';
import {relatedProjects,youtubeId,formatBytes} from '../../../lib/project-utils.mjs';
export async function getStaticPaths(){ return (await allProjects()).map(project=>({params:{slug:project.slug},props:{project}})); }
interface Props {project:Project}
const {project:p}=Astro.props;
const related: Project[]=relatedProjects(p,await allProjects());
const videoId=youtubeId(p.youtubeUrl);
const videoHref=videoId?`https://www.youtube.com/watch?v=${videoId}`:undefined;
---
<Layout title={p.title} description={p.description} image={p.heroImage||p.thumbnail}>
 <article class="container project-detail">
  <nav class="breadcrumbs" aria-label="パンくず"><a href={pathTo()}>HOME</a><Icon name="chevron" size={12}/><a href={pathTo('projects/')}>PROJECTS</a><Icon name="chevron" size={12}/><span>{p.title}</span></nav>
  <header class="detail-heading"><div class="detail-eyebrow"><span class="eyebrow">{p.category} / {p.subtitle}</span><span class="status">{p.status}</span>{p.demo&&<span class="demo-label static">DEMO DATA</span>}</div><h1>{p.title}</h1><p>{p.description}</p><div class="detail-heading-bottom"><div class="tags">{p.technologies.map(t=><a href={pathTo(`projects/?tech=${encodeURIComponent(t)}`)}>{t}</a>)}</div><time datetime={p.publishedAt}>ADDED {dateLabel(p.publishedAt)}</time></div></header>
  {p.demo&&<div class="notice demo-notice"><Icon name="code"/><div><strong>この作品は表示確認用のデモデータです。</strong><p>実際に公開・配布している作品ではありません。配布ファイルや動画リンクは設定していません。</p></div></div>}
  <div class="detail-hero"><img src={imagePath(p.heroImage||p.thumbnail)} alt={`${p.title}のメインビジュアル`} width="1440" height="810" fetchpriority="high"/></div>
  <div class="detail-layout"><div class="detail-content">
   <section class="detail-section"><p class="eyebrow">01 / OVERVIEW</p><h2>このプロジェクトについて</h2>{(p.overview.length?p.overview:[p.description]).map(text=><p>{text}</p>)}</section>
   {p.screenshots.length>0&&<section class="detail-section"><p class="eyebrow">02 / IN ACTION</p><h2>Screenshots</h2><div class="screenshot-grid">{p.screenshots.map((shot,index)=><button type="button" class="screenshot-button" data-gallery-open data-src={imagePath(shot.src)} data-alt={shot.alt} data-index={index} aria-label={`${shot.alt}を拡大`}><img src={imagePath(shot.src)} width="960" height="540" alt={shot.alt} loading="lazy"/><span><Icon name="external" size={18}/></span></button>)}</div><p class="caption">画像を選ぶと拡大できます。左右キーで切り替え、Escで閉じます。</p></section>}
   {p.features.length>0&&<section class="detail-section"><p class="eyebrow">03 / FEATURES</p><h2>できること</h2><ul class="feature-list">{p.features.map((text,index)=><li><span>{String(index+1).padStart(2,'0')}</span>{text}</li>)}</ul></section>}
   {p.technicalNotes.length>0&&<section class="detail-section"><p class="eyebrow">04 / UNDER THE HOOD</p><h2>技術メモ</h2><div class="technical-notes">{p.technicalNotes.map(text=><p><Icon name="code" size={18}/><span>{text}</span></p>)}</div></section>}
   {videoId&&<section class="detail-section" id="making-video"><p class="eyebrow">05 / MAKING OF</p><h2>制作の過程を、動画で。</h2><div class="video-facade" data-video-id={videoId} data-video-title={`${p.title}の制作動画`}><img src={imagePath(p.heroImage||p.thumbnail)} alt="" width="960" height="540" loading="lazy"/><button class="video-play" type="button"><span><Icon name="play" size={30}/></span>制作動画を再生<small>クリックするとYouTubeのプレイヤーを読み込みます</small></button></div><a class="text-link" href={videoHref} target="_blank" rel="noopener noreferrer">YouTubeで見る <Icon name="external" size={16}/></a></section>}
   {p.installationSteps.length>0&&<section class="detail-section" id="installation"><p class="eyebrow">06 / GET STARTED</p><h2>はじめかた</h2><ol class="installation-steps">{p.installationSteps.map(step=><li>{step}</li>)}</ol></section>}
   {p.changelog.length>0&&<section class="detail-section"><p class="eyebrow">07 / CHANGELOG</p><h2>更新履歴</h2><div class="changelog">{p.changelog.map(entry=><div><div><span class="version">v{entry.version}</span><time datetime={entry.date}>{dateLabel(entry.date)}</time></div><ul>{entry.changes.map(change=><li>{change}</li>)}</ul></div>)}</div></section>}
  </div>
  <aside class="download-panel" aria-labelledby="download-heading"><div class="download-top"><Icon name="download" size={23}/><span class="tiny-label">TAKE IT FOR A SPIN</span></div><h2 id="download-heading">プロジェクトを<br/>手元で動かそう。</h2><p>ソースコードを読んで、<br/>変えて、試してみてください。</p>
   {p.downloadUrl?<a class="button button-primary download-button" href={p.downloadUrl} data-download-link><Icon name="download"/> ZIPをダウンロード <Icon name="external" size={16}/></a>:<div class="button button-outline disabled" aria-disabled="true"><Icon name="download"/> ダウンロード準備中</div>}
   {videoHref&&<a class="button button-outline" href={videoHref} target="_blank" rel="noopener noreferrer"><Icon name="youtube"/> 制作動画を見る</a>}
   <dl class="download-info"><div><dt>VERSION</dt><dd>{p.version?`v${p.version}`:'準備中'}</dd></div><div><dt>FILE</dt><dd>{p.fileName||'準備中'}</dd></div><div><dt>SIZE</dt><dd>{formatBytes(p.fileSize)}</dd></div><div><dt>PLATFORM</dt><dd>{p.platform.join(' / ')||'未設定'}</dd></div><div><dt>UPDATED</dt><dd>{dateLabel(p.updatedAt)}</dd></div></dl>
   {p.requirements.length>0&&<div class="requirements"><h3>必要な環境</h3><ul>{p.requirements.map(text=><li>{text}</li>)}</ul></div>}
   <p class="download-note">{p.downloadUrl?'GitHub Releasesからダウンロードします。利用条件はZIP内のREADMEをご確認ください。':p.demo?'デモ作品のため、配布ファイルはありません。':'公開用ファイルを準備しています。配布が始まると、ここからダウンロードできます。'}</p>
  </aside></div>
  {related.length>0&&<section class="section related-section"><div class="section-heading"><div><p class="eyebrow">KEEP EXPLORING</p><h2>Related projects</h2></div><a class="text-link" href={pathTo('projects/')}>すべての作品 <Icon name="arrow"/></a></div><div class="project-grid">{related.map(project=><ProjectCard project={project}/>)}</div></section>}
 </article>
 <dialog class="lightbox" aria-label="スクリーンショット拡大表示"><div class="lightbox-toolbar"><span class="lightbox-caption"></span><button type="button" class="lightbox-close" aria-label="拡大表示を閉じる"><Icon name="close" size={26}/></button></div><div class="lightbox-content"><button type="button" class="lightbox-prev" aria-label="前の画像">←</button><img class="lightbox-image" src={imagePath(p.screenshots[0]?.src)} alt="" width="1280" height="720"/><button type="button" class="lightbox-next" aria-label="次の画像">→</button></div><p class="caption lightbox-counter"></p></dialog>
 <script>
  const gallery=[...document.querySelectorAll<HTMLButtonElement>('[data-gallery-open]')];
  const modal=document.querySelector<HTMLDialogElement>('.lightbox');
  if(modal&&gallery.length){
   let index=0;let opener:HTMLButtonElement|undefined;
   const show=(n:number)=>{index=(n+gallery.length)%gallery.length;const shot=gallery[index]!;const image=modal.querySelector<HTMLImageElement>('.lightbox-image')!;image.src=shot.dataset.src!;image.alt=shot.dataset.alt!;modal.querySelector('.lightbox-caption')!.textContent=shot.dataset.alt!;modal.querySelector('.lightbox-counter')!.textContent=`${index+1} / ${gallery.length}`;};
   gallery.forEach((button,n)=>button.addEventListener('click',()=>{opener=button;show(n);modal.showModal();document.body.classList.add('modal-open');}));
   const close=()=>modal.close();
   modal.querySelector('.lightbox-close')?.addEventListener('click',close);
   modal.querySelector('.lightbox-prev')?.addEventListener('click',()=>show(index-1));
   modal.querySelector('.lightbox-next')?.addEventListener('click',()=>show(index+1));
   modal.addEventListener('click',e=>{if(e.target===modal)close();});
   modal.addEventListener('keydown',e=>{if(e.key==='ArrowRight'){e.preventDefault();show(index+1);}if(e.key==='ArrowLeft'){e.preventDefault();show(index-1);}});
   modal.addEventListener('close',()=>{document.body.classList.remove('modal-open');opener?.focus();});
  }
  document.querySelectorAll<HTMLElement>('[data-video-id]').forEach(facade=>facade.querySelector('button')?.addEventListener('click',()=>{const iframe=document.createElement('iframe');iframe.src=`https://www.youtube-nocookie.com/embed/${facade.dataset.videoId}?autoplay=1`;iframe.title=facade.dataset.videoTitle||'制作動画';iframe.allow='accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';iframe.allowFullscreen=true;iframe.referrerPolicy='strict-origin-when-cross-origin';facade.replaceChildren(iframe);}));
 </script>
</Layout>
